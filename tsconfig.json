{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true,
		"types": [
			"node"
		],
		"lib": [
			"ES2022",
			"DOM",
			"DOM.Iterable"
		],
		"allowJs": true,
		"checkJs": true,
		"moduleDetection": "force"
	},
	"include": [
		"playwright.config.ts",
		"tests/e2e/**/*.ts",
		"wp-content/themes/pneukarnik/assets/js/**/*.js",
		"wp-content/plugins/pneukarnik-booking/assets/**/*.js"
	]
}
