{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/cards/**",
              "components/content/**",
              "components/core/**",
              "components/forms/**",
              "components/layout/**",
              "ui_kits/website/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Montserrat|Nunito Sans))/i]",
        "message": "Font not provided by the design system. Available: Montserrat, Nunito Sans."
      },
      {
        "selector": "JSXOpeningElement[name.name='Accordion'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|defaultOpen|key|ref|className|style|children)$/]",
        "message": "<Accordion> doesn't accept that prop. Declared props: items, defaultOpen."
      },
      {
        "selector": "JSXOpeningElement[name.name='ArrowLink'] > JSXAttribute > JSXIdentifier[name!=/^(?:href|back|tone|size|children|key|ref|className|style|children)$/]",
        "message": "<ArrowLink> doesn't accept that prop. Declared props: href, back, tone, size, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='ArrowLink'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:primary|accent)$/]",
        "message": "<ArrowLink> tone must be one of 'primary' | 'accent'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute > JSXIdentifier[name!=/^(?:initial|src|alt|size|tone|ring|key|ref|className|style|children)$/]",
        "message": "<Avatar> doesn't accept that prop. Declared props: initial, src, alt, size, tone, ring."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:primary|accent)$/]",
        "message": "<Avatar> tone must be one of 'primary' | 'accent'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|href|block|glow|disabled|type|onClick|children|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, href, block, glow, disabled, type, onClick, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:accent|primary|secondary|outline|dark|muted)$/]",
        "message": "<Button> variant must be one of 'accent' | 'primary' | 'secondary' | 'outline' | 'dark' | 'muted'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg|xl)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg' | 'xl'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:button|submit|reset)$/]",
        "message": "<Button> type must be one of 'button' | 'submit' | 'reset'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|padding|radius|gap|href|children|style|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: tone, padding, radius, gap, href, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:white|muted|tint|dark|primary|accent)$/]",
        "message": "<Card> tone must be one of 'white' | 'muted' | 'tint' | 'dark' | 'primary' | 'accent'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='radius'] > Literal[value!=/^(?:sm|md|lg|xl)$/]",
        "message": "<Card> radius must be one of 'sm' | 'md' | 'lg' | 'xl'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Checkbox'] > JSXAttribute > JSXIdentifier[name!=/^(?:checked|onChange|children|key|ref|className|style|children)$/]",
        "message": "<Checkbox> doesn't accept that prop. Declared props: checked, onChange, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='CheckList'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|tone|gap|size|key|ref|className|style|children)$/]",
        "message": "<CheckList> doesn't accept that prop. Declared props: items, tone, gap, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='CheckList'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:primary|accent)$/]",
        "message": "<CheckList> tone must be one of 'primary' | 'accent'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ChoiceChips'] > JSXAttribute > JSXIdentifier[name!=/^(?:options|value|onChange|tone|key|ref|className|style|children)$/]",
        "message": "<ChoiceChips> doesn't accept that prop. Declared props: options, value, onChange, tone."
      },
      {
        "selector": "JSXOpeningElement[name.name='ChoiceChips'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:primary|accent)$/]",
        "message": "<ChoiceChips> tone must be one of 'primary' | 'accent'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CourseCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|price|desc|href|cta|key|ref|className|style|children)$/]",
        "message": "<CourseCard> doesn't accept that prop. Declared props: name, price, desc, href, cta."
      },
      {
        "selector": "JSXOpeningElement[name.name='Eyebrow'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|children|key|ref|className|style|children)$/]",
        "message": "<Eyebrow> doesn't accept that prop. Declared props: tone, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Eyebrow'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:primary|accent|inherit)$/]",
        "message": "<Eyebrow> tone must be one of 'primary' | 'accent' | 'inherit'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Field'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|optional|optionalLabel|error|children|key|ref|className|style|children)$/]",
        "message": "<Field> doesn't accept that prop. Declared props: label, optional, optionalLabel, error, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:error|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: error."
      },
      {
        "selector": "JSXOpeningElement[name.name='MobileActionBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:callLabel|callHref|ctaLabel|ctaHref|fixed|key|ref|className|style|children)$/]",
        "message": "<MobileActionBar> doesn't accept that prop. Declared props: callLabel, callHref, ctaLabel, ctaHref, fixed."
      },
      {
        "selector": "JSXOpeningElement[name.name='Notice'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|children|key|ref|className|style|children)$/]",
        "message": "<Notice> doesn't accept that prop. Declared props: tone, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Notice'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:accent|info|danger)$/]",
        "message": "<Notice> tone must be one of 'accent' | 'info' | 'danger'."
