      {
        "selector": "JSXOpeningElement[name.name='PageHero'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:gradient|dark)$/]",
        "message": "<PageHero> variant must be one of 'gradient' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Pill'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|children|style|key|ref|className|style|children)$/]",
        "message": "<Pill> doesn't accept that prop. Declared props: tone, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Pill'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:white|muted|tint|accent)$/]",
        "message": "<Pill> tone must be one of 'white' | 'muted' | 'tint' | 'accent'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PlanCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:eyebrow|title|price|priceNote|features|ctaLabel|href|tone|key|ref|className|style|children)$/]",
        "message": "<PlanCard> doesn't accept that prop. Declared props: eyebrow, title, price, priceNote, features, ctaLabel, href, tone."
