      {
        "selector": "JSXOpeningElement[name.name='PlanCard'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:primary|accent)$/]",
        "message": "<PlanCard> tone must be one of 'primary' | 'accent'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PriceTable'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|intro|columns|rows|card|size|key|ref|className|style|children)$/]",
        "message": "<PriceTable> doesn't accept that prop. Declared props: title, intro, columns, rows, card, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='ReasonItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:n|title|text|key|ref|className|style|children)$/]",
        "message": "<ReasonItem> doesn't accept that prop. Declared props: n, title, text."
      },
      {
        "selector": "JSXOpeningElement[name.name='Section'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|align|tone|width|gap|padTop|padBottom|children|key|ref|className|style|children)$/]",
        "message": "<Section> doesn't accept that prop. Declared props: title, align, tone, width, gap, padTop, padBottom, children."
