        "selector": "JSXOpeningElement[name.name='SiteFooter'] > JSXAttribute > JSXIdentifier[name!=/^(?:brandPrefix|brandName|tagline|socialsTitle|socials|columns|legalTitle|legal|copyright|bottomLinks|key|ref|className|style|children)$/]",
        "message": "<SiteFooter> doesn't accept that prop. Declared props: brandPrefix, brandName, tagline, socialsTitle, socials, columns, legalTitle, legal, copyright, bottomLinks."
      },
      {
        "selector": "JSXOpeningElement[name.name='SiteHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:brandPrefix|brandName|tagline|logoSrc|homeHref|items|active|ctaLabel|ctaHref|breakpoint|extraMobileLinks|key|ref|className|style|children)$/]",
        "message": "<SiteHeader> doesn't accept that prop. Declared props: brandPrefix, brandName, tagline, logoSrc, homeHref, items, active, ctaLabel, ctaHref, breakpoint, extraMobileLinks."
      },
      {
        "selector": "JSXOpeningElement[name.name='Steps'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|highlightLast|min|key|ref|className|style|children)$/]",
        "message": "<Steps> doesn't accept that prop. Declared props: items, highlightLast, min."
